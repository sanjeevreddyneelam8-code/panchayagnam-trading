# ==============================================================================
# Environment Configuration Template for panchayagnam-service
# Copy this file to .env and adjust values for your environment.
# DO NOT COMMIT REAL SECRETS OR PASSWORDS TO SOURCE CONTROL.
# ==============================================================================

# Active Spring Profile (local, dev, h2, prod)
SPRING_PROFILES_ACTIVE=local
SERVER_PORT=8081

# Database Configuration (MySQL)
LOCAL_DB_URL=jdbc:mysql://localhost:3306/py_local?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
LOCAL_DB_USERNAME=root
LOCAL_DB_PASSWORD=your_local_db_password

DEV_DB_URL=jdbc:mysql://localhost:3306/py_dev?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
DEV_DB_USERNAME=root
DEV_DB_PASSWORD=your_dev_db_password

# JWT Authentication
JWT_SECRET=replace_with_a_secure_random_256_bit_secret_key_minimum_32_chars
JWT_EXPIRATION_MS=86400000

# Trading Mode: Paper-Trading Safety Switch (default: true)
# When true, all orders are executed in sandbox/simulation mode. No live broker orders are placed.
PAPER_TRADING_ENABLED=true

# Fast2SMS OTP Gateway Configuration
FAST2SMS_API_KEY=
FAST2SMS_ENABLED=false
FAST2SMS_URL=https://www.fast2sms.com/dev/bulkV2

# Twilio SMS OTP Configuration
TWILIO_ENABLED=false
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_API_KEY_SID=your_twilio_api_key_sid
TWILIO_API_SECRET=your_twilio_api_secret
TWILIO_SERVICE_SID=your_twilio_service_sid
TWILIO_FROM_NUMBER=+1234567890
TWILIO_OTP_EXPIRY_MINUTES=5

# Angel One SmartAPI Key
SMARTAPI_KEY=your_angelone_smartapi_key

# Outbound Email (SMTP)
SPRING_MAIL_HOST=smtpout.secureserver.net
SPRING_MAIL_PORT=465
SPRING_MAIL_USERNAME=customersupport@panchayagnam.com
SPRING_MAIL_PASSWORD=your_smtp_password
SPRING_MAIL_PROTOCOL=smtps
SPRING_MAIL_SMTP_AUTH=true
SPRING_MAIL_SSL_ENABLE=true
APP_MAIL_FROM=customersupport@panchayagnam.com
APP_MAIL_ALERT_TO=admin@panchayagnam.com
